   "source": [
    "import sys\n",
    "import pickle as pkl\n",
    "\n",
    "if 'graphics' in sys.modules: importlib.reload(sys.modules['graphics'])\n",
    "from graphics import *\n",
    "\n",
    "with open('test_coords.pkl', 'rb') as f:\n",
    "    data = pkl.load(f)\n",
    "\n",
    "plotly_2_graphs([data['orig'], data['recon']], 'Reconstruction from true contact maps')"
   ]
